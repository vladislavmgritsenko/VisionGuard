{$DOMAIN} {
    encode zstd gzip

    request_body {
        max_size 9MB
    }

    @private path /docs* /openapi.json /metrics
    respond @private 404

    reverse_proxy api:8000 {
        health_uri /health/ready
        health_interval 15s
        fail_duration 10s
        transport http {
            dial_timeout 5s
            response_header_timeout 120s
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }

    log {
        output stdout
        format json
    }
}
